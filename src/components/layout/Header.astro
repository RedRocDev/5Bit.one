---
import { Icon } from "astro-icon/components";
import { menuLinks } from "@/site.config";
---
<header class="sticky top-0 z-40 glass border-b border-base-300">
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <div class="flex items-center gap-2"><div class="dropdown lg:hidden"><button type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-menu" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-base-300 bg-base-200" aria-label="Toggle navigation menu"><Icon name="heroicons:bars-3" class="h-5 w-5" /></button><ul id="mobile-menu" class="dropdown-content menu menu-sm mt-3 w-52 border border-base-300 bg-base-100/95 backdrop-blur-xl">{menuLinks.map((link) => <li><a href={link.path} aria-current={Astro.url.pathname === link.path ? "page" : undefined}>{link.title}</a></li>)}</ul></div><a href="/" class="text-xl font-black tracking-tight" aria-label="5bit home">5bit</a></div>
    <div class="hidden items-center gap-1 lg:flex">{menuLinks.map((link) => <a href={link.path} class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${Astro.url.pathname === link.path ? "text-base-content" : "text-base-content/60 hover:text-base-content"}`} aria-current={Astro.url.pathname === link.path ? "page" : undefined}>{link.title}</a>)}</div>
    <div class="flex items-center gap-2"><a href="https://github.com/RedRocDev/5Bit.one" target="_blank" rel="noopener noreferrer" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-base-300 bg-base-200" aria-label="5bit website source on GitHub"><Icon name="simple-icons:github" class="h-4 w-4" /></a><a href="/download/" class="btn btn-primary h-9 px-4">Coming soon</a></div>
  </nav>
</header>
<script>
  const dropdown = document.querySelector<HTMLElement>(".dropdown");
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  const openMenu = (open: boolean) => { dropdown?.classList.toggle("open", open); toggle?.setAttribute("aria-expanded", String(open)); };
  toggle?.addEventListener("click", (event) => { event.stopPropagation(); openMenu(!dropdown?.classList.contains("open")); });
  document.addEventListener("click", (event) => { if (dropdown && !dropdown.contains(event.target as Node)) openMenu(false); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") { openMenu(false); toggle?.focus(); } });
</script>
