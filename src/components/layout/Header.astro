---
import { Icon } from "astro-icon/components";
import { menuLinks } from "@/site.config";
---

<header class="sticky top-0 z-40 px-3 pt-3 sm:px-5">
  <nav class="site-nav mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 rounded-2xl border border-base-content/10 bg-base-100/85 px-3 shadow-[0_18px_50px_-30px_rgba(0,0,0,.9)] backdrop-blur-xl sm:px-4">
    <div class="flex items-center gap-2">
      <div class="dropdown lg:hidden">
        <button type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-menu" class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-base-300 bg-base-200 text-base-content/70 transition hover:border-primary/40 hover:text-base-content" aria-label="Toggle navigation menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h16" /></svg>
        </button>
        <ul id="mobile-menu" class="dropdown-content menu menu-sm mt-3 w-56 rounded-2xl border border-base-300 bg-base-100/95 p-2 shadow-2xl backdrop-blur-xl">
          {menuLinks.map((link) => (
            <li><a href={link.path} class="rounded-xl px-3 py-2.5 text-sm font-semibold" aria-current={Astro.url.pathname === link.path ? "page" : undefined}>{link.title}</a></li>
          ))}
        </ul>
      </div>
      <a href="/" class="inline-flex items-center rounded-xl px-2 py-1">
        <img src="/5bit-logo.png" alt="5bit" class="h-9 w-auto sm:h-10" width="1758" height="663" />
      </a>
    </div>

    <div class="hidden items-center gap-1 rounded-xl border border-base-content/5 bg-base-200/55 p-1 lg:flex">
      {menuLinks.map((link) => {
        const active = Astro.url.pathname === link.path;
        return (
          <a href={link.path} class={`rounded-lg px-3.5 py-2 text-sm font-semibold transition ${active ? "nav-link-active" : "text-base-content/55 hover:bg-base-content/5 hover:text-base-content"}`} aria-current={active ? "page" : undefined}>
            {link.title}
          </a>
        );
      })}
    </div>

    <div class="flex items-center gap-2">
      <a href="https://github.com/RedRocDev/5Bit.one" target="_blank" rel="noopener noreferrer" class="hidden h-10 w-10 items-center justify-center rounded-xl border border-base-300 bg-base-200 text-base-content/65 transition hover:border-primary/40 hover:text-primary sm:inline-flex" aria-label="5bit on GitHub">
        <Icon name="simple-icons:github" class="h-4 w-4" />
      </a>
      <button
        type="button"
        data-theme-toggle
        class="theme-toggle inline-flex h-10 w-10 items-center justify-center rounded-xl border border-base-300 bg-base-200 text-base-content/65 transition hover:border-primary/40 hover:text-primary"
        aria-label="Switch to light mode"
        aria-pressed="false"
        title="Switch to light mode"
      >
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.2 15.2A8.6 8.6 0 0 1 8.8 3.8 8.6 8.6 0 1 0 20.2 15.2Z"></path>
        </svg>
      </button>
      <a href="/theme-designer/" class="btn btn-primary h-10 px-4">Make a theme</a>
    </div>
  </nav>
</header>

<script>
  const dropdown = document.querySelector<HTMLElement>(".dropdown");
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  function openMenu(open: boolean) {
    if (!dropdown) return;
    dropdown.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  }
  toggle?.addEventListener("click", (event) => { event.stopPropagation(); openMenu(!dropdown?.classList.contains("open")); });
  document.addEventListener("click", (event) => { if (dropdown && !dropdown.contains(event.target as Node)) openMenu(false); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") openMenu(false); });
  dropdown?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => openMenu(false)));

  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const themeMeta = document.querySelector<HTMLMetaElement>("#theme-color");

  function syncThemeToggle() {
    const current = document.documentElement.dataset.theme === "light" ? "light" : "dark";
    const target = current === "dark" ? "light" : "dark";
    themeToggle?.setAttribute("aria-label", `Switch to ${target} mode`);
    themeToggle?.setAttribute("title", `Switch to ${target} mode`);
    themeToggle?.setAttribute("aria-pressed", String(current === "light"));
    if (themeMeta) themeMeta.content = current === "light" ? "#fff9fc" : "#08090d";
  }

  function setTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    try { localStorage.setItem("5bit-color-mode", theme); } catch {}
    syncThemeToggle();
  }

  themeToggle?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme === "light" ? "light" : "dark";
    setTheme(current === "dark" ? "light" : "dark");
  });

  syncThemeToggle();
</script>
