---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/site.config";

const year = new Date().getFullYear();
const titleClass = "text-xs font-semibold uppercase tracking-[0.18em] text-base-content/40";
const linkClass = "text-sm text-base-content/60 transition-colors hover:text-primary";
---

<footer class="border-t border-base-300 bg-base-200/80 px-6 py-14">
  <div class="mx-auto grid max-w-7xl gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_0.8fr_0.8fr]">
    <div>
      <a href="/" class="inline-flex items-center">
        <img src="/5bit-logo.png" alt={siteConfig.title} class="h-8 w-auto" width="1758" height="663" />
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-base-content/50">
        One interface for the games, systems, and tools that make up your collection.
      </p>
      <div class="mt-5 flex items-center gap-2">
        <a href="https://github.com/RedRocDev/5Bit.one" target="_blank" rel="noopener noreferrer" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-content/60 transition hover:border-primary/50 hover:text-primary" aria-label="5bit on GitHub">
          <Icon name="simple-icons:github" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <nav class="flex flex-col gap-2.5">
      <h6 class={titleClass}>Product</h6>
      <a href="/downloads/" class={linkClass}>Downloads</a>
      <a href="/integrations/" class={linkClass}>Integrations</a>
      <a href="/guide/" class={linkClass}>Guide</a>
    </nav>

    <nav class="flex flex-col gap-2.5">
      <h6 class={titleClass}>Create</h6>
      <a href="/theme-designer/" class={linkClass}>Theme Designer</a>
      <a href="/guide/#folder-compatibility" class={linkClass}>Folder Structure</a>
    </nav>

    <nav class="flex flex-col gap-2.5">
      <h6 class={titleClass}>Project</h6>
      <a href="https://github.com/RedRocDev/5Bit.one" target="_blank" rel="noopener noreferrer" class={linkClass}>GitHub</a>
      <a href="https://github.com/RedRocDev/5Bit.one/issues" target="_blank" rel="noopener noreferrer" class={linkClass}>Report an issue</a>
    </nav>
  </div>

  <div class="mx-auto mt-12 max-w-4xl border-t border-base-300 pt-8 text-center">
    <h6 class="text-[11px] font-bold uppercase tracking-[0.24em] text-primary">Disclaimer</h6>
    <p class="mx-auto mt-3 text-xs leading-6 text-base-content/40">
      5bit is an independent gaming frontend and is not affiliated with or endorsed by Nintendo, Sony, Microsoft, Sega, Valve, or other platform holders. 5bit does not provide copyrighted games, ROMs, BIOS/firmware, keys, or other protected game content. Users are responsible for obtaining and using their games and software lawfully. Product names, logos, trademarks, and other third-party assets belong to their respective owners. Compatibility references do not imply endorsement. 5bit is provided as-is without warranty.
    </p>
    <p class="mt-6 text-xs text-base-content/35">&copy; {year} {siteConfig.title}. All rights reserved.</p>
  </div>
</footer>
