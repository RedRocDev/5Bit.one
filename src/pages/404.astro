---
import Base from "@/layouts/Base.astro";
---
<Base meta={{ title: "Page not found", description: "The requested page could not be found." }}><section class="mx-auto max-w-3xl px-6 py-28 text-center"><p class="font-mono text-primary">404</p><h1 class="mt-4 text-5xl font-black">This page wandered off.</h1><p class="mt-5 text-base-content/60">The address may have changed, or the page may not exist yet.</p><a href="/" class="btn btn-primary mt-8">Back home</a></section></Base>
