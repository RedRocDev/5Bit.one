---
import PageLayout from "@/layouts/Base.astro";
import { Icon } from "astro-icon/components";
import fs from "node:fs";
import path from "node:path";

const meta = {
  description:
    "Comprehensive guide to setting up and using 5bit across all platforms.",
  title: "User Guide",
};

// Automate Folder Compatibility Table
const systemsDir = path.resolve("./public/systems");
const files = fs
  .readdirSync(systemsDir)
  .filter(
    (f) =>
      f.endsWith(".json") &&
      !["all.json", "android.json", "manifest.json"].includes(f),
  );

const allSystems = files.map((file) => {
  const content = fs.readFileSync(path.join(systemsDir, file), "utf-8");
  return JSON.parse(content);
});

const sortedSystems = allSystems.sort((a, b) =>
  a.system.name.localeCompare(b.system.name),
);

const systemsManifest = JSON.parse(
  fs.readFileSync(path.join(systemsDir, "manifest.json"), "utf-8"),
);
const systemsVersion: string = systemsManifest.latest_version ?? "N/A";

const totalSystems = sortedSystems.length;
const emulationCompatibleCount = sortedSystems.filter(
  (s) => s.emulators && s.emulators.length > 0,
).length;

const systemTypeMeta: Record<string, { label: string; icon: string; color: string }> = {
  console: { label: "Console", icon: "mdi:television-classic", color: "text-primary" },
  handheld: { label: "Handheld", icon: "mdi:hand-coin", color: "text-success" },
  computer: { label: "Computer", icon: "mdi:desktop-tower-monitor", color: "text-info" },
  virtual: { label: "Virtual", icon: "mdi:memory", color: "text-warning" },
  arcade: { label: "Arcade", icon: "mdi:gamepad-variant", color: "text-secondary" },
};

const systemTypes = Object.entries(systemTypeMeta);

const toc = [
  { id: "getting-started", label: "Getting Started", icon: "heroicons:flag" },
  { id: "installation", label: "Installation", icon: "heroicons:arrow-down-tray" },
  {
    id: "setup-configuration",
    label: "Setup & Config",
    icon: "heroicons:cog-6-tooth",
  },
  { id: "integrations", label: "Integrations", icon: "heroicons:bolt" },
  {
    id: "folder-compatibility",
    label: "Folder Structure",
    icon: "heroicons:folder-open",
  },
];
---
<PageLayout meta={meta}>
  <div class="relative py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <!-- Hero -->
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-base-content/5 rounded-full border border-base-content/20 text-xs font-bold text-base-content/70 uppercase tracking-widest mb-6"
        >
          <Icon name="heroicons:book-open" class="w-4 h-4 text-primary" />
          Complete Manual
        </div>
        <h1
          class="text-4xl md:text-6xl font-black text-base-content mb-6 tracking-tight"
        >
          User <span class="text-primary">Guide</span>
        </h1>
        <div class="max-w-3xl mx-auto">
          <p class="text-lg md:text-xl text-base-content/60 leading-relaxed mb-10">
            Use this guide for the current 5bit setup model, folder conventions,
            platform notes, and the parts of the ecosystem being designed around it.
          </p>

          <div class="flex flex-wrap justify-center gap-3">
            <div
              class="inline-flex items-center gap-3 px-5 py-3 bg-primary/10 rounded-2xl border border-primary/20"
            >
              <Icon name="heroicons:check-circle" class="w-6 h-6 text-primary" />
              <div class="text-left">
                <div class="text-xl font-black text-base-content leading-none">
                  {emulationCompatibleCount}
                </div>
                <div class="text-[10px] text-base-content/50 uppercase tracking-widest font-bold mt-1">
                  Systems Supported
                </div>
              </div>
            </div>
            <div
              class="inline-flex items-center gap-3 px-5 py-3 bg-info/10 rounded-2xl border border-info/20"
            >
              <Icon name="heroicons:swatch" class="w-6 h-6 text-info" />
              <div class="text-left">
                <div class="text-xl font-black text-base-content leading-none">40</div>
                <div class="text-[10px] text-base-content/50 uppercase tracking-widest font-bold mt-1">Theme Presets</div>
              </div>
            </div>
            <div
              class="inline-flex items-center gap-3 px-5 py-3 bg-warning/10 rounded-2xl border border-warning/20"
            >
              <Icon name="heroicons:globe-alt" class="w-6 h-6 text-warning" />
              <div class="text-left">
                <div class="text-xl font-black text-base-content leading-none">
                  {totalSystems}
                </div>
                <div class="text-[10px] text-base-content/50 uppercase tracking-widest font-bold mt-1">
                  Systems Tracked
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row gap-12 relative items-start">
        <!-- Sidebar / Table of Contents -->
        <aside class="lg:w-72 shrink-0 lg:sticky lg:top-24">
          <div class="card card-border bg-base-200">
            <div class="card-body p-6">
              <h3 class="text-sm font-bold text-primary uppercase tracking-widest mb-4">Navigation</h3>
              <ul class="menu">
                {toc.map((item) => (
                  <li><a href={`#${item.id}`} class="flex items-center gap-3 text-sm">
                    <Icon name={item.icon} class="w-4 h-4 text-primary" />
                    {item.label}
                  </a></li>
                ))}
              </ul>
            </div>
          </div>

          <div class="card card-border bg-primary/10 mt-6">
            <div class="card-body items-center text-center">
              <p class="text-xs text-base-content/60 italic mb-4">Found a problem or unclear step?</p>
              <a href="https://github.com/RedRocDev/5Bit.one/issues" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm btn-block">Report an issue</a>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-grow space-y-16">
          <!-- Getting Started -->
          <section id="getting-started" class="scroll-mt-24">
            <div class="flex items-center gap-4 mb-8">
              <h2
                class="text-3xl font-bold text-base-content pl-6 border-l-4 border-primary"
              >
                Getting Started
              </h2>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center">
                      <Icon name="heroicons:arrow-down-tray" class="w-6 h-6 text-primary" />
                    </div>
                    <span class="text-4xl font-black text-base-content/10">1</span>
                  </div>
                  <h3 class="font-bold text-base-content mb-1">Download</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed">
                    Get the application from the <a
                      href="/downloads"
                      class="text-primary hover:underline font-medium"
                      >downloads page</a
                    >.
                  </p>
                </div>
              </div>
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-info/10 flex items-center justify-center">
                      <Icon name="heroicons:computer-desktop" class="w-6 h-6 text-info" />
                    </div>
                    <span class="text-4xl font-black text-base-content/10">2</span>
                  </div>
                  <h3 class="font-bold text-base-content mb-1">Install</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed">
                    Install the app on your device following the platform-specific steps.
                  </p>
                </div>
              </div>
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-warning/10 flex items-center justify-center">
                      <Icon name="heroicons:folder-open" class="w-6 h-6 text-warning" />
                    </div>
                    <span class="text-4xl font-black text-base-content/10">3</span>
                  </div>
                  <h3 class="font-bold text-base-content mb-1">Add your ROMs</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed">
                    Select your ROMs folder, following the <a
                      href="#folder-compatibility"
                      class="text-primary hover:underline font-medium"
                      >standard structure</a
                    >.
                  </p>
                </div>
              </div>
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 rounded-2xl bg-success/10 flex items-center justify-center">
                      <Icon name="heroicons:rocket-launch" class="w-6 h-6 text-success" />
                    </div>
                    <span class="text-4xl font-black text-base-content/10">4</span>
                  </div>
                  <h3 class="font-bold text-base-content mb-1">Play</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed">
                    Launch the app and follow the on-screen instructions to start gaming.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Installation -->
          <section id="installation" class="scroll-mt-24">
            <div class="flex items-center gap-4 mb-8">
              <h2
                class="text-3xl font-bold text-base-content pl-6 border-l-4 border-primary"
              >
                Installation
              </h2>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <!-- Win -->
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div
                    class="w-14 h-14 rounded-2xl bg-info/10 flex items-center justify-center mb-4"
                  >
                    <Icon name="simple-icons:windows" class="w-8 h-8 text-info" />
                  </div>
                  <h3 class="text-xl font-bold text-base-content mb-4">Windows</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-6">
                    Simple and portable. No installer needed.
                  </p>
                  <div class="p-4 bg-base-content/5 rounded-2xl border border-base-content/10">
                    <p class="text-xs text-base-content/70">
                      Unzip the ZIP file into a folder and run <code
                        class="text-primary bg-primary/10 px-1.5 py-0.5 rounded font-mono"
                        >5bit.exe</code
                      >.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Android -->
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div
                    class="w-14 h-14 rounded-2xl bg-success/10 flex items-center justify-center mb-4"
                  >
                    <Icon name="simple-icons:android" class="w-8 h-8 text-success" />
                  </div>
                  <h3 class="text-xl font-bold text-base-content mb-4">Android</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-6">
                    Optimized for touch and handheld screens.
                  </p>
                  <div class="space-y-3">
                    <div class="alert alert-warning">
                      <p class="text-xs leading-relaxed">
                        <strong>Important:</strong> On Android 11+, you must enable "All Files Access" in settings to manage games.
                      </p>
                    </div>
                    <div class="alert alert-info">
                      <p class="text-xs leading-relaxed">
                        Install the APK manually from our <a href="/downloads" class="text-primary hover:underline">downloads page</a>.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Linux -->
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div
                    class="w-14 h-14 rounded-2xl bg-warning/10 flex items-center justify-center mb-4"
                  >
                    <Icon name="simple-icons:linux" class="w-8 h-8 text-warning" />
                  </div>
                  <h3 class="text-xl font-bold text-base-content mb-4">Linux</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-6">
                    Universal AppImage support.
                  </p>
                  <div
                    class="bg-base-100 p-3 rounded-xl border border-base-content/10 font-mono text-xs text-warning"
                  >
                    chmod +x 5bit-Linux.AppImage
                  </div>
                  <p class="text-xs text-base-content/50 mt-4 leading-relaxed">
                    Make the file executable and run it via terminal or file
                    manager.
                  </p>
                </div>
              </div>

              <!-- macOS -->
              <div class="card card-border bg-base-200 relative overflow-hidden">
                <div class="card-body">
                  <div
                    class="w-14 h-14 rounded-2xl bg-secondary/10 flex items-center justify-center mb-4"
                  >
                    <Icon name="simple-icons:apple" class="w-8 h-8 text-secondary" />
                  </div>
                  <h3 class="text-xl font-bold text-base-content mb-4">macOS</h3>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-6">
                    Native DMG for Intel & Silicon.
                  </p>
                  <div class="alert alert-warning">
                    <p class="text-xs leading-relaxed">
                      If blocked, go to <strong>Privacy &amp; Security Settings</strong> and click "Open Anyway".
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Setup & Configuration -->
          <section id="setup-configuration" class="scroll-mt-24">
            <div class="flex items-center gap-4 mb-8">
              <h2
                class="text-3xl font-bold text-base-content pl-6 border-l-4 border-primary"
              >
                Setup & Configuration
              </h2>
            </div>

            <div class="space-y-8">
              <!-- ROMS Structure -->
              <div class="card card-border bg-base-200">
                <div class="card-body">
                  <div class="flex flex-col xl:flex-row gap-8 items-center">
                    <div class="flex-grow">
                      <h3
                        class="text-xl font-bold text-base-content mb-4 flex items-center gap-3"
                      >
                        <Icon
                          name="heroicons:folder-open"
                          class="text-warning w-6 h-6"
                        />
                        ROMs Folder Structure
                      </h3>
                      <p class="text-base-content/60 text-sm leading-relaxed mb-6">
                        Your ROMs folder must contain subfolders organized by
                        system (e.g., <code class="text-warning">nes</code>, <code
                          class="text-warning">snes</code
                        >). 5bit will auto-detect these based on the
                        standard naming convention.
                      </p>
                      <div class="flex flex-col items-start gap-2">
                        <a
                          href="#folder-compatibility"
                          class="text-xs font-bold text-warning uppercase tracking-widest"
                          >View all folder names →</a
                        >
                        <a
                          href="/downloads/5bit-rom-folder-structure.zip"
                          download
                          class="text-xs font-bold text-primary uppercase tracking-widest transition hover:text-primary-soft"
                          >Download preset folder structure ↓</a
                        >
                      </div>
                    </div>
                    <div class="shrink-0 max-w-sm">
                      <img
                        src="/guide/guide-01.webp"
                        alt="Structure Example"
                        class="rounded-2xl border border-base-content/20"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Desktop Config -->
              <div class="card card-border bg-base-200">
                <div class="card-body">
                  <div class="flex flex-col xl:flex-row gap-8 items-center">
                    <div class="flex-grow">
                      <h3
                        class="text-xl font-bold text-base-content mb-4 flex items-center gap-3"
                      >
                        <Icon
                          name="heroicons:pencil-square"
                          class="text-info w-6 h-6"
                        />
                        Desktop Binary Setup
                      </h3>
                      <p class="text-base-content/60 text-sm leading-relaxed mb-6">
                        On PC/Mac, you must manually point to your emulator
                        executable (e.g., <code class="text-info"
                          >retroarch.exe</code
                        >) in the application's General Settings.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Integrations -->
          <section id="integrations" class="scroll-mt-24">
            <div class="flex items-center gap-4 mb-8">
              <h2
                class="text-3xl font-bold text-base-content pl-6 border-l-4 border-primary"
              >
                Integrations
              </h2>
            </div>

            <p class="text-base-content/60 text-sm leading-relaxed mb-8">
              These are ecosystem tools 5bit is being designed to work alongside.
              Exact integration behaviour will be documented as features are implemented and tested.
            </p>

            <!-- Integration Cards -->
            <div class="grid md:grid-cols-2 gap-6">

              <!-- RomM -->
              <div class="card card-border bg-base-200">
                <div class="card-body">
                  <div class="flex items-center gap-4 mb-5">
                    <div class="w-14 h-14 rounded-2xl bg-base-content/5 flex items-center justify-center shrink-0 p-2.5">
                      <img src="/providers/romm.svg" alt="RomM" class="w-full h-full object-contain" />
                    </div>
                    <div>
                      <h3 class="card-title">RomM</h3>
                      <span class="badge badge-ghost badge-sm">ROM Manager</span>
                    </div>
                  </div>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-5">
                    Self-hosted ROM manager with a beautiful web interface.
                    Manage your library from anywhere while keeping full control
                    of your data on your own server.
                  </p>
                  <div class="flex flex-wrap gap-2 mb-5">
                    {["Self-hosted", "Web UI", "Metadata", "Multi-user"].map((f) => (
                      <span class="badge badge-ghost badge-outline badge-sm">{f}</span>
                    ))}
                  </div>
                  <div class="alert alert-info p-3">
                    <Icon name="heroicons:information-circle" class="w-4 h-4 shrink-0" />
                    <span class="text-xs text-base-content/60">
                      Your collection lives on your hardware, full privacy.
                    </span>
                  </div>
                  <a href="https://romm.app/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block mt-5">
                    romm.app <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
                  </a>
                </div>
              </div>

              <!-- RetroAchievements -->
              <div class="card card-border bg-base-200">
                <div class="card-body">
                  <div class="flex items-center gap-4 mb-5">
                    <div class="w-14 h-14 rounded-2xl bg-warning/10 flex items-center justify-center shrink-0 p-2.5">
                      <img src="/providers/retroachievements.svg" alt="RetroAchievements" class="w-full h-full object-contain" />
                    </div>
                    <div>
                      <h3 class="card-title">RetroAchievements</h3>
                      <span class="badge badge-warning badge-sm">Achievements</span>
                    </div>
                  </div>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-5">
                    The community achievement system for classic games and a target for future 5bit integration.
                  </p>
                  <div class="flex flex-wrap gap-2 mb-5">
                    {["Achievements", "Progress", "Leaderboards"].map((f) => (
                      <span class="badge badge-warning badge-outline badge-sm">{f}</span>
                    ))}
                  </div>
                  <div class="alert alert-info p-3">
                    <Icon name="heroicons:information-circle" class="w-4 h-4 shrink-0" />
                    <span class="text-xs text-base-content/60">
                      Support details will be documented when the integration is implemented.
                    </span>
                  </div>
                  <a href="https://retroachievements.org" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block mt-5">
                    retroachievements.org <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
                  </a>
                </div>
              </div>

              <!-- ScreenScraper -->
              <div class="card card-border bg-base-200">
                <div class="card-body">
                  <div class="flex items-center gap-4 mb-5">
                    <div class="w-14 h-14 rounded-2xl bg-info/10 flex items-center justify-center shrink-0 p-2.5">
                      <img src="/providers/screenscraper.svg" alt="ScreenScraper" class="w-full h-full object-contain" />
                    </div>
                    <div>
                      <h3 class="card-title">ScreenScraper</h3>
                      <span class="badge badge-info badge-sm">Metadata</span>
                    </div>
                  </div>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-5">
                    A community game database and potential metadata source for artwork, descriptions, and release information.
                  </p>
                  <div class="flex flex-wrap gap-2 mb-5">
                    {["Batch scraping", "Box art", "Real game names"].map((f) => (
                      <span class="badge badge-info badge-outline badge-sm">{f}</span>
                    ))}
                  </div>
                  <div class="alert alert-info p-3">
                    <Icon name="heroicons:information-circle" class="w-4 h-4 shrink-0" />
                    <span class="text-xs text-base-content/60">
                      Metadata behaviour will be documented when the integration is implemented.
                    </span>
                  </div>
                  <a href="https://www.screenscraper.fr" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block mt-5">
                    screenscraper.fr <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
                  </a>
                </div>
              </div>

              <!-- RetroArch -->
              <div class="card card-border bg-base-200 md:col-span-2">
                <div class="card-body">
                  <div class="flex items-center gap-4 mb-5">
                    <div class="w-14 h-14 rounded-2xl bg-success/10 flex items-center justify-center shrink-0 p-2.5">
                      <img src="/providers/retroarch.svg" alt="RetroArch" class="w-full h-full object-contain" />
                    </div>
                    <div>
                      <h3 class="card-title">RetroArch</h3>
                      <span class="badge badge-success badge-sm">Emulation</span>
                    </div>
                  </div>
                  <p class="text-base-content/60 text-sm leading-relaxed mb-5">
                    The multi-system emulator frontend is a major compatibility target for 5bit.
                  </p>
                  <div class="flex flex-wrap gap-2 mb-5">
                    {["LibRetro cores", "Save states", "SRAM saves", "Cross-platform"].map((f) => (
                      <span class="badge badge-success badge-outline badge-sm">{f}</span>
                    ))}
                  </div>
                  <div class="alert alert-info p-3">
                    <Icon name="heroicons:information-circle" class="w-4 h-4 shrink-0" />
                    <span class="text-xs text-base-content/60">
                      Core, save, and launch behaviour will be documented when integration testing is complete.
                    </span>
                  </div>
                  <a href="https://www.retroarch.com" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block mt-5">
                    retroarch.com <Icon name="heroicons:arrow-top-right-on-square" class="w-4 h-4" />
                  </a>
                </div>
              </div>
            </div>
          </section>

          <!-- Dynamic Folders -->
          <section id="folder-compatibility" class="scroll-mt-24">
            <div class="flex items-center gap-4 mb-8">
              <h2
                class="text-3xl font-bold text-base-content pl-6 border-l-4 border-primary"
              >
                Folder Structure
              </h2>
              <div class="flex-grow h-px bg-base-content/5"></div>
            </div>

            <div class="card card-border bg-base-200 overflow-hidden">
              <div class="p-6 border-b border-base-content/10 flex flex-col md:flex-row md:items-center gap-4">
                <p class="text-xs text-base-content/60 italic flex-grow">
                  Automatically generated from system metadata. 5bit
                  auto-detects folders by these standard names.
                </p>
                <div class="flex items-center gap-2 text-xs text-base-content/50 font-bold shrink-0">
                  <Icon name="heroicons:tag" class="w-4 h-4 text-primary" />
                  v{systemsVersion}
                </div>
                <div class="flex items-center gap-2 text-xs text-base-content/50 font-bold shrink-0">
                  <Icon name="heroicons:squares-2x2" class="w-4 h-4 text-primary" />
                  {totalSystems} systems
                </div>
              </div>

              <div class="p-4 border-b border-base-content/10 bg-base-100/40 space-y-4">
                <div class="flex flex-col sm:flex-row gap-3">
                  <label class="input input-bordered input-sm flex items-center gap-2 flex-grow">
                    <Icon name="heroicons:magnifying-glass" class="w-4 h-4 opacity-50" />
                    <input
                      id="system-search"
                      type="text"
                      class="grow"
                      placeholder="Search systems…"
                    />
                  </label>
                </div>
                <div class="flex flex-wrap gap-2" id="system-type-filters">
                  <button data-type="all" class="btn btn-xs btn-primary btn-outline">All</button>
                  {systemTypes.map(([key, t]) => (
                    <button data-type={key} class="btn btn-xs btn-outline">
                      <Icon name={t.icon} class={`w-3.5 h-3.5 ${t.color}`} />
                      {t.label}
                    </button>
                  ))}
                </div>
              </div>

              <div class="overflow-hidden border-t border-base-300">
                <div class="overflow-x-auto max-h-[32rem] overflow-y-auto">
                  <table class="w-full text-left text-sm">
                    <thead class="sticky top-0 z-10 bg-base-300/80 backdrop-blur">
                      <tr>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-widest text-base-content/50 w-56">System</th>
                        <th class="px-4 py-3 text-xs font-bold uppercase tracking-widest text-base-content/50 w-64">Folders</th>
                        <th class="hidden md:table-cell px-4 py-3 text-xs font-bold uppercase tracking-widest text-base-content/50">Extensions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {
                        sortedSystems.map((s) => {
                          const type = s.system.details?.type ?? "console";
                          const t = systemTypeMeta[type] ?? { label: "Console", icon: "mdi:television-classic", color: "text-primary" };
                          return (
                            <tr data-system data-name={(s.system.name || "").toLowerCase()} data-type={type} class="border-t border-base-300/50 transition-colors hover:bg-base-100/60">
                              <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                  <div class={`w-9 h-9 rounded-lg ${t.color === "text-primary" ? "bg-primary/10" : t.color === "text-success" ? "bg-success/10" : t.color === "text-info" ? "bg-info/10" : t.color === "text-warning" ? "bg-warning/10" : "bg-secondary/10"} flex items-center justify-center shrink-0`}>
                                    <Icon name={t.icon} class={`w-5 h-5 ${t.color}`} />
                                  </div>
                                  <div class="min-w-0">
                                    <div class="font-semibold leading-tight text-base-content">{s.system.name}</div>
                                    <div class="text-[11px] text-base-content/45">{s.system.details?.manufacturer ?? "N/A"}</div>
                                  </div>
                                </div>
                              </td>
                              <td class="px-4 py-3">
                                <div class="font-mono text-xs text-base-content/70 leading-relaxed">
                                  {s.system.folders.join(", ")}
                                </div>
                              </td>
                              <td class="hidden md:table-cell px-4 py-3">
                                <div class="font-mono text-xs text-primary/80 leading-relaxed">
                                  {s.system.extensions?.map((e: string) => `.${e}`).join("  ") ?? "N/A"}
                                </div>
                              </td>
                            </tr>
                          );
                        })
                      }
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="p-4 border-t border-base-content/10 text-center">
                <p class="text-xs text-base-content/50" id="system-results-count">
                  Showing {totalSystems} systems
                </p>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  const searchInput = document.getElementById("system-search") as HTMLInputElement | null;
  const typeButtons = document.querySelectorAll<HTMLButtonElement>("#system-type-filters button");
  const rows = document.querySelectorAll<HTMLElement>("#folder-compatibility tbody tr[data-system]");
  const resultsCount = document.getElementById("system-results-count");
  let activeType = "all";

  if (searchInput && rows.length > 0) {
    const applyFilters = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const name = row.getAttribute("data-name") ?? "";
        const type = row.getAttribute("data-type") ?? "console";
        const matchesType = activeType === "all" || type === activeType;
        const matchesQuery = name.includes(query);
        const show = matchesType && matchesQuery;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (resultsCount) {
        resultsCount.textContent = `Showing ${visible} of ${rows.length} systems`;
      }
    };

    searchInput.addEventListener("input", applyFilters);

    typeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        typeButtons.forEach((b) => b.classList.remove("btn-primary"));
        btn.classList.add("btn-primary");
        activeType = btn.getAttribute("data-type") ?? "all";
        applyFilters();
      });
    });
  }
</script>
