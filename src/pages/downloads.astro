---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
  description: "5bit release status and planned platform support.",
  title: "Downloads",
};

const platforms = [
  { name: "Windows", icon: "simple-icons:windows", note: "64-bit" },
  { name: "Android", icon: "simple-icons:android", note: "Phones & handhelds" },
  { name: "Linux", icon: "simple-icons:linux", note: "x64 & ARM64 planned" },
  { name: "macOS", icon: "simple-icons:apple", note: "Intel & Apple Silicon planned" },
];
---

<PageLayout meta={meta}>
  <section class="relative py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-warning/30 bg-warning/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-warning">
          <Icon name="heroicons:wrench-screwdriver" class="h-4 w-4" /> Active development
        </div>
        <h1 class="mt-7 text-5xl font-black tracking-tight md:text-7xl">5bit downloads are <span class="text-neon-gradient">not public yet.</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/60">
          This page will only publish 5bit-owned installers and release links. Previous upstream download URLs have been removed rather than relabelled as 5bit.
        </p>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {platforms.map((p) => (
          <div class="card card-border bg-base-200">
            <div class="card-body p-6">
              <Icon name={p.icon} class="h-8 w-8 text-primary" />
              <h2 class="mt-3 text-lg font-bold">{p.name}</h2>
              <p class="text-sm text-base-content/50">{p.note}</p>
              <span class="mt-4 inline-flex w-fit rounded-full border border-base-300 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-base-content/45">Coming later</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href="https://github.com/RedRocDev/5Bit.one" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <Icon name="simple-icons:github" class="h-4 w-4" /> Follow development
        </a>
        <a href="/guide/" class="btn btn-ghost border border-base-content/20">Read the guide</a>
      </div>
    </div>
  </section>
</PageLayout>
