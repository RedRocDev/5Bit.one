---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
  description: "The tools and services 5bit is being designed to work alongside.",
  title: "Integrations",
};

const integrations = [
  { name: "RetroArch", img: "/providers/retroarch.svg", url: "https://www.retroarch.com", role: "Emulation", text: "A major target for multi-system emulation and core management." },
  { name: "RomM", img: "/providers/romm.svg", url: "https://romm.app/", role: "Library", text: "A self-hosted library ecosystem that may complement local 5bit collections." },
  { name: "RetroAchievements", img: "/providers/retroachievements.svg", url: "https://retroachievements.org", role: "Achievements", text: "Achievement support is part of the intended connected gaming experience." },
  { name: "ScreenScraper", img: "/providers/screenscraper.svg", url: "https://www.screenscraper.fr", role: "Metadata", text: "One potential source for artwork and structured game metadata." },
];
---

<PageLayout meta={meta}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <div class="text-xs font-bold uppercase tracking-[0.22em] text-primary">Ecosystem</div>
          <h1 class="mt-4 text-5xl font-black tracking-tight md:text-7xl">Connect the tools <span class="text-neon-gradient">you choose.</span></h1>
        </div>
        <p class="text-lg leading-relaxed text-base-content/60">
          5bit is being designed as the layer that brings a gaming setup together. The integrations below are targets and ecosystem relationships, not a claim that every feature is already shipping.
        </p>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-2">
        {integrations.map((i, index) => (
          <a href={i.url} target="_blank" rel="noopener noreferrer" class="group card card-border bg-base-200 p-7 transition hover:-translate-y-1 hover:border-primary/45">
            <div class="flex items-start gap-5">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-base-300 bg-base-100 p-3">
                <img src={i.img} alt={i.name} class="h-full w-full object-contain opacity-80 group-hover:opacity-100" />
              </div>
              <div>
                <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">{String(index + 1).padStart(2, "0")} · {i.role}</div>
                <h2 class="mt-1 text-xl font-black">{i.name}</h2>
                <p class="mt-2 text-sm leading-relaxed text-base-content/55">{i.text}</p>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 rounded-2xl border border-warning/20 bg-warning/5 p-6 text-sm text-base-content/60">
        <strong class="text-warning">Status note:</strong> integration scope will be updated as 5bit functionality becomes real and testable.
      </div>
    </div>
  </section>
</PageLayout>
