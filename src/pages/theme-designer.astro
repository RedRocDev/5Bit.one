                  <span class="tool"><svg class="ico"><use href="#i-trophy"/></svg></span>
                  <span class="tool"><svg class="ico"><use href="#i-scan"/></svg></span>
                  <span class="tool"><svg class="ico"><use href="#i-gear"/></svg></span>
                  <span class="shoulder">RB</span>
                </div>
                <div class="status">
                  <svg class="ico"><use href="#i-clock"/></svg><span class="clk">18:07</span>
