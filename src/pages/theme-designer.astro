"#34D399","success-content":"#06291F","warning":"#FBBF24","warning-content":"#2D1B00","error":"#FB7185","error-content":"#35050D"}},"5bit_beetroot":{"name":"Beetroot","id":"5bit_beetroot","author":"5bit","scheme":"dark","effects":{"radius-selector":"0.25rem","radius-field":"0.125rem","radius-box":"0.375rem","border":"2px","size-selector":"0.25rem","size-field":"0.25rem"},"colors":{"base-100":"#0C0305","base-200":"#190609","base-300":"#26090D","base-content":"#FFF0F2","primary":"#FF2438","primary-content":"#FFFFFF","secondary":"#B00020","secondary-content":"#FFFFFF","accent":"#FF7A24","accent-content":"#FFFFFF","neutral":"#08090C","neutral-content":"#ECEEF4","info":"#38BDF8","info-content":"#051C29","success":"#34D399","success-content":"#06291F","warning":"#FBBF24","warning-content":"#2D1B00","error":"#FB7185","error-content":"#35050D"}},"5bit_boing":{"name":"Boing","id":"5bit_boing","author":"5bit","scheme":"dark","effects":{"radius-selector":"0rem","radius-field":"0rem","radius-box":"0rem","border":"2px","size-selector":"0.25rem","size-field":"0.25rem"},"colors":{"base-100":"#050509","base-200":"#0B0B12","base-300":"#12121D","base-content":"#FAFAFF","primary":"#FF245F","primary-content":"#FFFFFF","secondary":"#00D8FF","secondary-content":"#111318","accent":"#FFD400","accent-content":"#111318","neutral":"#08090C","neutral-content":"#ECEEF4","info":"#38BDF8","info-content":"#051C29","success":"#34D399","success-content":"#06291F","warning":"#FBBF24","warning-content":"#2D1B00","error":"#FB7185","error-content":"#35050D"}},"5bit_flump":{"name":"Flump","id":"5bit_flump","author":"5bit","scheme":"dark","effects":{"radius-selector":"0.875rem","radius-field":"0.625rem","radius-box":"1.25rem","border":"1px","size-selector":"0.25rem","size-field":"0.25rem"},"colors":{"base-100":"#0C0717","base-200":"#160B28","base-300":"#22103A","base-content":"#FFF2FF","primary":"#FF5AC8","primary-content":"#FFFFFF","secondary":"#7C5CFF","secondary-content":"#FFFFFF","accent":"#00E5FF","a