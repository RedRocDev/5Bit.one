                <div class="tile side a3"><div class="art"><span class="logo">ATARI 7800</span></div></div>
              </div>
    
              <div class="filterrow">
                <span class="fpill">ALL</span><span class="fpill">ANDROID</span><span class="fpill">ARCADE</span>
                <span class="fpill sel">A2600</span><span class="fpill">A7800</span><span class="fpill">LYNX</span>
                <span class="fpill">CV</span><span class="fpill">C64</span><span class="fpill">FDS</span>
                <span class="fpill">GB</span><span class="fpill">GBA</span><span class="fpill">GBC</span>
              </div>
    
              <div class="browsefoot">
                <span class="sysname">Atari 2600<span class="count">636 Games</span></span>
                <div class="foot-actions">
                  <span class="tbfab set"><svg class="ico"><use href="#i-list"/></svg>Settings</span>
                  <span class="tbfab enter"><span class="glyph g-a">A</span>Enter</span>
