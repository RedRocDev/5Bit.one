---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
  description: "A cleaner way to bring together games from different platforms, launchers, and systems — with one consistent experience from start to finish.",
  title: "One Interface, One Experience",
  ogImage: "/screenshots/5bit-01.png",
};

const platforms = [
  { name: "Windows", icon: "simple-icons:windows" },
  { name: "Android", icon: "simple-icons:android" },
  { name: "Linux", icon: "simple-icons:linux" },
  { name: "macOS", icon: "simple-icons:apple" },
];

const integrations = [
  { name: "RetroArch", img: "/providers/retroarch.svg", url: "https://www.retroarch.com" },
  { name: "RomM", img: "/providers/romm.svg", url: "https://romm.app/" },
  { name: "RetroAchievements", img: "/providers/retroachievements.svg", url: "https://retroachievements.org" },
  { name: "ScreenScraper", img: "/providers/screenscraper.svg", url: "https://www.screenscraper.fr" },
];

const themeNames = ["Brrr", "Spicy", "Gonzo", "Biscuit", "Pickle", "Bubbles", "Moon", "Zap"];
---

<PageLayout meta={meta}>
  <!-- Asymmetric hero -->
  <section class="mx-auto max-w-7xl px-4 pb-16 pt-10 md:pb-24 md:pt-16">
    <div class="grid gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/8 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-primary">
          <span class="h-2 w-2 rounded-full bg-primary shadow-[0_0_14px_var(--color-primary)]"></span>
          Gaming, without the mess
        </div>
        <h1 class="mt-7 text-5xl font-black leading-[0.96] tracking-[-0.055em] sm:text-6xl md:text-7xl">
          One Interface.<br /><span class="text-neon-gradient">One Experience.</span>
        </h1>
        <p class="mt-7 text-lg leading-8 text-base-content/60">
          5bit is being built as one home for games spread across platforms, launchers, emulators, and folders — without making the technical parts the main event.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#gallery" class="btn btn-primary btn-lg">See the interface <Icon name="heroicons:arrow-down" class="h-4 w-4" /></a>
          <a href="/theme-designer/" class="btn btn-ghost btn-lg border border-base-content/15">Theme Designer</a>
        </div>
        <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-xs font-semibold text-base-content/45">
          <span class="flex items-center gap-2"><Icon name="heroicons:swatch" class="h-4 w-4 text-primary" /> 40 theme presets</span>
          <span class="flex items-center gap-2"><Icon name="heroicons:rectangle-group" class="h-4 w-4 text-secondary" /> One library model</span>
          <span class="flex items-center gap-2"><Icon name="heroicons:wrench-screwdriver" class="h-4 w-4 text-accent" /> Active development</span>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-5 rounded-[2.4rem] bg-gradient-to-br from-primary/20 via-transparent to-secondary/15 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-[2rem] border border-base-content/15 bg-base-200 p-2 shadow-2xl">
          <img src="/screenshots/5bit-01.png" alt="5bit interface" class="aspect-video w-full rounded-[1.55rem] object-cover" />
        </div>
        <div class="absolute -bottom-5 -left-3 hidden w-44 overflow-hidden rounded-2xl border border-base-content/15 bg-base-100 p-1 shadow-2xl sm:block md:w-52">
          <img src="/screenshots/5bit-02.png" alt="5bit alternate interface" class="aspect-video w-full rounded-xl object-cover" />
        </div>
        <div class="absolute -right-3 top-7 rounded-2xl border border-primary/25 bg-base-100/90 px-4 py-3 shadow-xl backdrop-blur">
          <div class="text-[10px] font-black uppercase tracking-[0.2em] text-primary">Status</div>
          <div class="mt-1 text-sm font-bold">Preview build</div>
        </div>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-base-content/10 bg-base-content/10 sm:grid-cols-4">
      {platforms.map((p) => (
        <div class="flex items-center justify-center gap-3 bg-base-200/90 px-4 py-4 text-sm font-bold text-base-content/70">
          <Icon name={p.icon} class="h-5 w-5 text-primary" /> {p.name}
        </div>
      ))}
    </div>
  </section>

  <!-- Product logic, editorial not card-heavy -->
  <section class="border-y border-base-content/8 bg-base-200/35">
    <div class="mx-auto max-w-7xl px-4 py-20 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
        <div>
          <div class="text-xs font-black uppercase tracking-[0.22em] text-secondary">The idea</div>
          <h2 class="mt-4 text-4xl font-black tracking-tight md:text-5xl">Your setup should feel like <span class="text-neon-gradient">one thing.</span></h2>
        </div>
        <div class="divide-y divide-base-content/10 border-y border-base-content/10">
          <div class="grid gap-3 py-7 sm:grid-cols-[4rem_1fr]">
            <div class="text-4xl font-black text-primary/35">01</div>
            <div><h3 class="text-xl font-black">Point</h3><p class="mt-2 text-base-content/55">Tell 5bit where the games and tools in your setup live.</p></div>
          </div>
          <div class="grid gap-3 py-7 sm:grid-cols-[4rem_1fr]">
            <div class="text-4xl font-black text-secondary/35">02</div>
            <div><h3 class="text-xl font-black">Shape</h3><p class="mt-2 text-base-content/55">Organise the library, choose a visual identity, and keep advanced controls available without putting them in the way.</p></div>
          </div>
          <div class="grid gap-3 py-7 sm:grid-cols-[4rem_1fr]">
            <div class="text-4xl font-black text-accent/35">03</div>
            <div><h3 class="text-xl font-black">Play</h3><p class="mt-2 text-base-content/55">Launch from a consistent interface instead of mentally switching between a pile of separate tools.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento screenshot wall -->
  <section id="gallery" class="mx-auto max-w-7xl px-4 py-20 md:py-24">
    <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div><div class="text-xs font-black uppercase tracking-[0.22em] text-primary">Interface</div><h2 class="mt-3 text-4xl font-black tracking-tight md:text-5xl">Not another launcher-shaped website.</h2></div>
      <p class="max-w-md text-sm leading-6 text-base-content/50">Six real 5bit screenshots, arranged as part of the page rather than hidden behind a generic carousel.</p>
    </div>
    <div class="grid auto-rows-[150px] grid-cols-1 gap-4 sm:auto-rows-[180px] md:grid-cols-12">
      <button class="modal-trigger group relative overflow-hidden rounded-[1.6rem] border border-base-content/12 bg-base-200 text-left md:col-span-7 md:row-span-2" data-image="/screenshots/5bit-01.png"><img src="/screenshots/5bit-01.png" alt="5bit screenshot 1" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></button>
      <button class="modal-trigger group relative overflow-hidden rounded-[1.6rem] border border-base-content/12 bg-base-200 text-left md:col-span-5" data-image="/screenshots/5bit-02.png"><img src="/screenshots/5bit-02.png" alt="5bit screenshot 2" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></button>
      <button class="modal-trigger group relative overflow-hidden rounded-[1.6rem] border border-base-content/12 bg-base-200 text-left md:col-span-5" data-image="/screenshots/5bit-03.png"><img src="/screenshots/5bit-03.png" alt="5bit screenshot 3" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></button>
      <button class="modal-trigger group relative overflow-hidden rounded-[1.6rem] border border-base-content/12 bg-base-200 text-left md:col-span-4" data-image="/screenshots/5bit-04.png"><img src="/screenshots/5bit-04.png" alt="5bit screenshot 4" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></button>
      <button class="modal-trigger group relative overflow-hidden rounded-[1.6rem] border border-base-content/12 bg-base-200 text-left md:col-span-4" data-image="/screenshots/5bit-05.png"><img src="/screenshots/5bit-05.png" alt="5bit screenshot 5" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></button>
      <button class="modal-trigger group relative overflow-hidden rounded-[1.6rem] border border-base-content/12 bg-base-200 text-left md:col-span-4" data-image="/screenshots/5bit-06.png"><img src="/screenshots/5bit-06.png" alt="5bit screenshot 6" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></button>
    </div>
  </section>

  <!-- Theme designer as a core product feature -->
  <section class="mx-auto max-w-7xl px-4 pb-20 md:pb-24">
    <div class="overflow-hidden rounded-[2rem] border border-primary/20 bg-gradient-to-br from-primary/10 via-base-200 to-secondary/8 p-8 md:p-12">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="text-xs font-black uppercase tracking-[0.22em] text-primary">Make it yours</div>
          <h2 class="mt-3 text-4xl font-black tracking-tight md:text-5xl">Themes should have <span class="text-neon-gradient">personality.</span></h2>
          <p class="mt-5 max-w-xl leading-7 text-base-content/55">Pick one of the deliberately loud presets or build your own JSON theme in the browser. Short names, strong palettes, no beige corporate wallpaper.</p>
          <a href="/theme-designer/" class="btn btn-primary mt-7">Open Theme Designer <Icon name="heroicons:arrow-right" class="h-4 w-4" /></a>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {themeNames.map((name, i) => (
            <div class={`flex aspect-square items-end rounded-2xl border p-3 font-black ${i % 4 === 0 ? "border-cyan-300/30 bg-cyan-300/15 text-cyan-100" : i % 4 === 1 ? "border-orange-400/30 bg-orange-500/15 text-orange-100" : i % 4 === 2 ? "border-lime-300/30 bg-lime-400/15 text-lime-100" : "border-pink-400/30 bg-pink-500/15 text-pink-100"}`}>{name}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Integrations as compact rail, not cards -->
  <section class="border-y border-base-content/8 bg-base-200/35">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-md"><div class="text-xs font-black uppercase tracking-[0.22em] text-secondary">Ecosystem targets</div><h2 class="mt-2 text-2xl font-black">Use the tools that make sense.</h2></div>
        <div class="flex flex-wrap gap-2">
          {integrations.map((i) => (
            <a href={i.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-full border border-base-content/10 bg-base-100 px-4 py-2.5 text-sm font-bold text-base-content/65 transition hover:border-primary/40 hover:text-base-content">
              <img src={i.img} alt="" class="h-5 w-5 object-contain opacity-75" /> {i.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final status CTA -->
  <section class="mx-auto max-w-7xl px-4 py-20 md:py-24">
    <div class="grid gap-8 border-l-4 border-primary pl-7 md:grid-cols-[1fr_auto] md:items-center md:pl-10">
      <div><div class="text-xs font-black uppercase tracking-[0.22em] text-primary">Current status</div><h2 class="mt-3 text-3xl font-black md:text-4xl">5bit is still being built.</h2><p class="mt-3 max-w-2xl text-base-content/55">No borrowed download binaries, no fake release badge. Follow the repository while the real product catches up with the interface.</p></div>
      <div class="flex flex-wrap gap-3"><a href="https://github.com/RedRocDev/5Bit.one" target="_blank" rel="noopener noreferrer" class="btn btn-primary"><Icon name="simple-icons:github" class="h-4 w-4" /> GitHub</a><a href="/guide/" class="btn btn-ghost border border-base-content/15">Guide</a></div>
    </div>
  </section>
</PageLayout>

<div id="imageModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4" role="dialog" aria-modal="true" aria-label="Screenshot preview">
  <button id="modalClose" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-black/50 text-2xl text-white" aria-label="Close preview">×</button>
  <img id="modalImage" src="" alt="5bit screenshot preview" class="max-h-[90vh] max-w-[94vw] rounded-2xl border border-white/10 object-contain shadow-2xl" />
</div>

<script>
  const modal = document.getElementById("imageModal");
  const modalImage = document.getElementById("modalImage") as HTMLImageElement | null;
  const close = document.getElementById("modalClose");
  const shut = () => { modal?.classList.add("hidden"); modal?.classList.remove("flex"); document.body.style.overflow = ""; };
  document.querySelectorAll<HTMLElement>(".modal-trigger").forEach((trigger) => trigger.addEventListener("click", () => {
    const src = trigger.dataset.image; if (!src || !modal || !modalImage) return; modalImage.src = src; modal.classList.remove("hidden"); modal.classList.add("flex"); document.body.style.overflow = "hidden";
  }));
  close?.addEventListener("click", shut);
  modal?.addEventListener("click", (event) => { if (event.target === modal) shut(); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") shut(); });
</script>
