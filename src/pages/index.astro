---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
const capabilities = [
  ["Unified library", "Bring native games, apps, and emulated collections into one browseable home.", "heroicons:squares-2x2"],
  ["Controller first", "Navigate from the sofa, a handheld, or the desktop without changing mental models.", "heroicons:cursor-arrow-rays"],
  ["Setup assistance", "Planned guidance for emulators, cores, firmware detection, and verification.", "heroicons:wrench-screwdriver"],
  ["System Doctor", "Planned diagnostics to explain what is ready, missing, or needs attention.", "heroicons:heart"],
];
---
<Base meta={{ title: "One home for gaming", description: "5bit is a universal gaming home in development for computers, TVs, handhelds, and mobile devices." }}>
  <section class="mx-auto max-w-7xl px-6 py-24 text-center sm:py-32"><span class="badge badge-primary">Early development</span><h1 class="mx-auto mt-6 max-w-4xl text-5xl font-black tracking-tight sm:text-7xl">One home for <span class="text-gradient">gaming.</span></h1><p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-base-content/65">5bit is being designed to bring games and applications together across devices, from desktop PCs to the biggest screen in the house.</p><div class="mt-9 flex flex-wrap justify-center gap-3"><a href="/platforms/" class="btn btn-primary btn-lg">Explore the direction</a><a href="/download/" class="btn btn-secondary btn-lg">Download status</a></div></section>
  <section class="border-y border-base-300 bg-base-200/50"><div class="mx-auto max-w-7xl px-6 py-16"><div class="max-w-2xl"><span class="badge badge-warning">Planned</span><h2 class="mt-4 text-3xl font-bold tracking-tight">A calmer way to manage a growing library</h2><p class="mt-3 text-base-content/60">This baseline describes the product direction. It does not claim that unfinished features are available.</p></div><div class="mt-10 grid gap-4 sm:grid-cols-2">{capabilities.map(([title, description, icon]) => <article class="card card-body"><Icon name={icon} class="h-6 w-6 text-primary" /><h3 class="card-title mt-2">{title}</h3><p class="text-sm leading-6 text-base-content/60">{description}</p></article>)}</div></div></section>
  <section class="mx-auto max-w-7xl px-6 py-20"><div class="grid gap-8 rounded-2xl border border-base-300 bg-base-200 p-8 lg:grid-cols-[1fr_auto] lg:items-center"><div><span class="badge badge-info">Coming later</span><h2 class="mt-4 text-3xl font-bold">Cloud features, when the foundations are ready</h2><p class="mt-3 max-w-2xl text-base-content/60">Cloud capabilities are part of the longer-term direction, not the current baseline.</p></div><a href="/docs/" class="btn btn-outline">Read the project notes</a></div></section>
</Base>
